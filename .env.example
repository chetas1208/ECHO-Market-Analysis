# ECHO configuration template. Copy to .env; never commit .env or real credentials.

# APPLICATION MODE
# live = explicitly enabled hosted providers; replay = deterministic fixtures;
# offline = no external provider calls.
ECHO_MODE=replay
APP_ENV=development
LOG_LEVEL=INFO

# NEON / POSTGRESQL SYSTEM OF RECORD
# Local development uses the compose service. Replace DATABASE_URL with the
# Neon pooled URL for hosted environments and set DATABASE_PROVIDER=neon.
DATABASE_PROVIDER=local
POSTGRES_USER=echo
POSTGRES_PASSWORD=echo_dev_password
POSTGRES_DB=echo
DATABASE_URL=postgresql+asyncpg://echo:echo_dev_password@localhost:5433/echo
# DATABASE_DIRECT_URL=postgresql+asyncpg://...
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300
# disable for local Postgres, require for Neon; prefer leaves provider defaults.
DB_SSL_MODE=prefer

# API / FRONTEND
API_HOST=127.0.0.1
API_PORT=8100
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:8100

# SHOCKGRAPH / AURE
# The safe default is the deterministic in-process graph path. Enable AURE
# only after setting a verified executable and an existing .auredb.
GRAPH_BACKEND=networkx
GRAPH_FALLBACK_BACKEND=networkx
AURE_ENABLED=false
# AURE_BINARY=/absolute/path/to/aure
# AURE_DATABASE_PATH=/absolute/path/to/graph.auredb
# AURE_CONFIG_PATH=/absolute/path/to/aure-config.toml
AURE_QUERY_TIMEOUT_SECONDS=5

# MARKET DATA: off | replay | massive | alpaca
ECHO_MARKET_PROVIDER=replay
ECHO_MARKET_FALLBACK=none
ECHO_MARKET_QUEUE_SIZE=5000
ECHO_MARKET_REPLAY_SPEED=0
# MASSIVE_API_KEY=
MASSIVE_REPO_PATH=
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_FEED=iex

# WORLD MONITOR
# off | replay | world_monitor. Hosted MCP tools may require authentication.
ECHO_WORLD_PROVIDER=replay
WORLD_PROVIDER=replay
ECHO_WORLD_POLL_INTERVAL_S=1800
ECHO_WORLD_REPLAY_SPEED=0
ECHO_WORLD_TEXT_MODEL=off
WORLD_MONITOR_API_KEY=
WORLD_MONITOR_BASE_URL=https://api.worldmonitor.app
WORLD_MONITOR_TRANSPORT=rest
WORLDMONITOR_MCP_ENABLED=false
WORLDMONITOR_MCP_URL=https://worldmonitor.app/mcp
WORLDMONITOR_MCP_TRANSPORT=mcp
WORLDMONITOR_REPO_PATH=

# ALPACA PAPER EXECUTION
# ECHO rejects LIVE execution. Both secret/paper aliases are supported for
# Alpaca MCP compatibility; ECHO's API adapter names remain canonical.
ECHO_EXECUTION_MODE=DISABLED
ECHO_EXECUTION_KILL_SWITCH=false
ECHO_EXECUTION_ALLOWED_SYMBOLS=NVDA,AMD,MSFT
ALPACA_PAPER=true
ALPACA_PAPER_TRADE=true
ALPACA_SECRET_KEY=
ALPACA_MCP_ENABLED=false
ALPACA_MCP_REPO_PATH=
ALPACA_TOOLSETS=account,trading,assets,stock-data

# OPTIONAL JEV
JEV_ENABLED=false
JEV_API_KEY=
JEV_MODEL=typesafe/jev-1.13

# Optional provider-specific extras. Do not put credentials in frontend env.
# CONVICTION_API_KEY=
